// README
// Copy to .env: cp env.example .env
// Never commit .env (it is gitignored).

// --- Local / optional ---
REACT_APP_GITHUB_TOKEN = "YOUR GITHUB TOKEN HERE"
GITHUB_USERNAME = "YOUR GITHUB USERNAME HERE"
USE_GITHUB_DATA = "true"
MEDIUM_USERNAME = "YOUR MEDIUM USERNAME HERE"

// --- GitHub Actions Variable RESUME_URL (preferred) ---
// Same link for local builds. REACT_APP_RESUME_URL is only an optional CRA alias
// for the same value — you do not need both.
RESUME_URL = "https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing"
SUBSTACK_RSS = "https://YOUR_PUBLICATION.substack.com/feed"
